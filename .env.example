# GEMINI_API_KEY: Required for Gemini AI API calls (TTS, STT, Medium Multi-AI tier).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Multi-AI Orchestration Keys (server-side only):
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.1-8b-instant"
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="anthropic/claude-sonnet-4.6"

# SQLite Database Path (defaults to ./data/mcp-bridge.sqlite):
# MCP_DB_PATH="./data/mcp-bridge.sqlite"

# Optional MCP Web Bridge Security Settings (e.g. for Render):
# MCP_BEARER_TOKEN="your_secret_bearer_token"
# MCP_BLOCK_PRIVATE_NETS="true"
# MCP_ALLOWED_DOMAINS=""
